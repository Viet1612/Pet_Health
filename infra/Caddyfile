# SPA tĩnh + reverse proxy (SAD §2.0, §2.1.1, §3.2.2), header bảo mật và CSP (S7-01).
{
	admin off
	# TLS kết thúc ở Cloudflare; Caddy chỉ nhận HTTP trong mạng nội bộ Docker
	auto_https off
}

:8080 {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(self)"
		-Server
	}

	respond /healthz-caddy 200

	handle /api/* {
		# ảnh ≤ 5 MB + phần multipart
		request_body {
			max_size 6MB
		}
		# Cache-Control: no-store do API đặt; CF-Connecting-IP được chuyển nguyên
		reverse_proxy api:3000
	}

	handle /media/* {
		# Cache-Control: private, max-age=900 do API đặt
		reverse_proxy api:3000
	}

	handle {
		root * /srv/www
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@notAssets not path /assets/*
		header @notAssets Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
