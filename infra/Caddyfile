# SPA tĩnh + reverse proxy (SAD §2.0, §2.1.1, §3.2.2). CSP và header bảo mật thêm ở S7-01.
{
	admin off
	# TLS kết thúc ở Cloudflare
	auto_https off
}

:8080 {
	encode zstd gzip

	handle /api/* {
		# ảnh ≤ 5 MB + phần multipart
		request_body {
			max_size 6MB
		}
		# Cache-Control: no-store do API đặt; CF-Connecting-IP được chuyển nguyên
		reverse_proxy api:3000
	}

	handle /media/* {
		# Cache-Control: private, max-age=900 do API đặt
		reverse_proxy api:3000
	}

	handle {
		root * /srv/www
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@notAssets not path /assets/*
		header @notAssets Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
