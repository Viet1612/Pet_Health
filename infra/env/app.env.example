# Mẫu biến môi trường cho api/worker ở staging và production.
# Tệp thật nằm ở /srv/pethealth/secrets/*.env, quyền 600, chủ root (SAD §4.1.6). Không commit tệp thật.
# Mọi giá trị bí mật để trống ở đây.

NODE_ENV=production
LOG_LEVEL=info
PORT=3000
# Đổi khi có tên miền thật (DEC-021)
APP_ORIGIN=https://app.pethealth.example

# PostgreSQL trong mạng Docker nội bộ "db"
POSTGRES_PASSWORD=
DATABASE_URL=postgres://app_rw:<mật khẩu>@postgres:5432/pethealth
WORKER_DATABASE_URL=postgres://app_worker:<mật khẩu>@postgres:5432/pethealth
MIGRATION_DATABASE_URL=postgres://app_owner:<mật khẩu>@postgres:5432/pethealth
DB_POOL_MAX=10
WORKER_DB_POOL_MAX=5

# Request luôn đi qua cloudflared nên tin header CF-Connecting-IP
TRUST_CF_CONNECTING_IP=true
HEARTBEAT_FILE=/tmp/alive

# SMTP Gmail (AD-008): tài khoản Gmail riêng cho Pet Health, bật xác minh 2 bước
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Địa chỉ Gmail riêng
SMTP_USER=
# Gmail App Password
SMTP_PASS=
SMTP_FROM=
SMTP_DAILY_LIMIT=400

MEDIA_ROOT=/data/media
# ≥ 32 byte ngẫu nhiên, ví dụ: openssl rand -base64 48
MEDIA_SIGNING_KEY=
ANALYTICS_HMAC_KEY=

# Token Cloudflare Tunnel (dùng cho container cloudflared)
TUNNEL_TOKEN=
