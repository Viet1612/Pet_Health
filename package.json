{
  "name": "pet-health",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev:up": "docker compose -f infra/compose.dev.yml up -d --wait",
    "dev:down": "docker compose -f infra/compose.dev.yml down",
    "dev:reset": "psql -v ON_ERROR_STOP=1 -q -f infra/dev/db-reset.sql \"postgres://ph_owner:ph_owner_dev@localhost:5432/postgres\"",
    "docker:full": "docker compose -f infra/compose.dev.yml --profile full up -d --build",
    "db:migrate": "pnpm --filter @ph/api migrate",
    "openapi:gen": "pnpm --filter @ph/api openapi:gen",
    "dev": "pnpm --parallel --filter @ph/api --filter @ph/web dev",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:api": "playwright test --config e2e/playwright.config.ts --project api",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.int.test.ts\"",
    "test:integration": "vitest run .int.test",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
