NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
APP_ORIGIN=http://localhost:5173
# api dùng app_rw (bị RLS chặn), worker dùng app_worker (BYPASSRLS); tạo bằng infra/dev/roles.sql
DATABASE_URL=postgres://app_rw:app_rw_dev@localhost:5432/pethealth
WORKER_DATABASE_URL=postgres://app_worker:app_worker_dev@localhost:5432/pethealth
MIGRATION_DATABASE_URL=postgres://ph_owner:ph_owner_dev@localhost:5432/pethealth
DB_POOL_MAX=10
WORKER_DB_POOL_MAX=5
TRUST_CF_CONNECTING_IP=false
HEARTBEAT_FILE=./.data/alive
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pet Health <dev@pethealth.local>
SMTP_DAILY_LIMIT=400
MEDIA_ROOT=./.data/media
MEDIA_SIGNING_KEY=dev-only-not-secret-change-me-0000000000
ANALYTICS_HMAC_KEY=dev-only-not-secret-change-me-1111111111
